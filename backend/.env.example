# ProofPay Backend Configuration
PROJECT_NAME=ProofPay
API_V1_STR=/api/v1
SECRET_KEY=proofpay_super_secret_jwt_key_hackathon_2026_dev
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# For SQLite development (default):
DATABASE_URL=sqlite:///./proofpay.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/proofpay

# PayPal REST API (Sandbox)
# Mode: "sandbox" (for real sandbox credentials) or "simulation" (for built-in offline testing)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# Google Gemini API (for multimodal vision verification & dispute mediation)
GEMINI_API_KEY=your_gemini_api_key_here

# Storage
STORAGE_TYPE=local
UPLOAD_DIR=app/storage/uploads
MAX_FILE_SIZE_MB=25
